{%- liquid
  assign shop_metafields = shop.metafields.reviews_app
  assign star_color = block.settings.star_color | default: shop_metafields.star_color.value | default: '#FFC107'
  assign star_empty_color = block.settings.star_empty_color | default: shop_metafields.star_empty_color.value | default: '#E0E0E0'
  assign text_color = block.settings.text_color | default: shop_metafields.text_color.value | default: '#1A1A1A'
-%}

<div
  class="rw-inline-rating"
  data-shop="{{ shop.permanent_domain }}"
  data-product-id="{{ product.id }}"
  data-app-url="/apps/reviewly"
  style="
    display: none;
    --rw-star-color: {{ star_color }};
    --rw-star-empty: {{ star_empty_color }};
    --rw-text-color: {{ text_color }};
    --rw-font-family: {{ block.settings.font_family | default: 'inherit' }};
  "
  {{ block.shopify_attributes }}
>
  <div class="rw-inline-rating__stars" data-rw-inline-stars>
    {% render 'stars', rating: 0 %}
  </div>
  <a class="rw-inline-rating__link" href="#reviews-widget-{{ block.id }}" data-rw-inline-count> (0 reviews) </a>
</div>

<style data-reviewly-config>
  .reviewly-scope-star_rating {
    --rw-scope-ready: 1;
  }
</style>

<script>
  (function () {
    var inlines = document.querySelectorAll('.rw-inline-rating');
    if (!inlines.length) return;
    var root = inlines[inlines.length - 1]; // Target most recent if multiple
    root.classList.add('reviewly-scope-star_rating');

    var shop = root.dataset.shop;
    var url = '/apps/reviewly/api/widget-config?shop=' + encodeURIComponent(shop) + '&widget=star_rating';

    fetch(url, { headers: { Accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (cfg) {
        if (!cfg) return;
        if (!cfg.enabled) {
          inlines.forEach(function(el) { el.style.display = 'none'; });
          return;
        }

        var s = cfg.settings || {};
        inlines.forEach(function(el) {
          if (s.starColor) el.style.setProperty('--rw-star-color', s.starColor);
          if (s.starEmptyColor) el.style.setProperty('--rw-star-empty', s.starEmptyColor);
          if (s.textColor) el.style.setProperty('--rw-text-color', s.textColor);
          if (s.fontFamily) el.style.setProperty('--rw-font-family', s.fontFamily);
        });

        if (cfg.css) {
          var style = document.createElement('style');
          style.setAttribute('data-reviewly-custom', '');
          style.textContent = cfg.css;
          document.head.appendChild(style);
        }
      })
      .catch(function (err) { console.warn('[reviewly] config load failed', err); });
  })();
</script>

{% schema %}
{
  "name": "Star Rating Badge",
  "target": "section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#FFC107"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Empty star color",
      "default": "#E0E0E0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1A1A1A"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Font family",
      "options": [
        { "value": "inherit", "label": "Theme default" },
        { "value": "'Inter', sans-serif", "label": "Inter" },
        { "value": "'Poppins', sans-serif", "label": "Poppins" },
        { "value": "Georgia, serif", "label": "Georgia" }
      ],
      "default": "inherit"
    }
  ]
}
{% endschema %}
